rules_version = '2';

// PenSight는 Firebase Auth를 사용하지 않는다. 닉네임 + PIN으로 로그인하면 서버(netlify/functions/auth.js)가
// 세션 토큰을 발급하고, 문서 생성·조회·수정·삭제와 외부 API 호출은 모두 서버 함수가 토큰을 검증한 뒤
// firebase-admin SDK(규칙을 우회함)로 처리한다. 따라서 클라이언트가 Firestore에 직접 접근하는 경로는 없으며
// 모든 컬렉션의 클라이언트 읽기/쓰기를 차단한다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 닉네임/PIN 확인·등록·초기화·삭제는 모두 서버 함수(auth.js, admin-data.js)를 거친다.
    // 클라이언트가 Firestore로 users 컬렉션에 직접 접근하는 경로는 없다.
    match /users/{nickname} {
      allow read, write: if false;
    }

    // 문서는 서버 함수(documents.js)가 세션 토큰의 닉네임 기준으로만 생성·조회·수정·삭제한다.
    match /documents/{docId} {
      allow read, write: if false;
    }

    // 그 외 컬렉션은 전부 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
